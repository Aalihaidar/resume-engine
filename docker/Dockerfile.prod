# docker/Dockerfile.prod
# Production image: serves the FastAPI app (api.py) — JSON-in/PDF-out API
# plus the manual-fill web form. This is the image deployed to Render.
#
# Multi-stage build:
#   1. "builder" — has compilers/uv, resolves + installs dependencies and
#      the project itself into a standalone venv.
#   2. "runtime" — starts fresh from a slim base, copies only the finished
#      venv + source, adds WeasyPrint's *runtime* libs (no -dev/-headers
#      packages, no compilers, no git/ssh), and runs as a non-root user.
#
# Result: no build tools, no shell-access tooling, no root, small final
# image.

# ---------- Stage 1: builder ----------
FROM python:3.14-slim-bookworm AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.11.7 /uv /uvx /usr/local/bin/

ENV UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_COMPILE_BYTECODE=1

WORKDIR /build

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY README.md ./
COPY src ./src
RUN uv sync --frozen --no-dev --no-editable

# ---------- Stage 2: runtime ----------
FROM python:3.14-slim-bookworm AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libcairo2 \
    libgdk-pixbuf-2.0-0 \
    libffi8 \
    shared-mime-info \
    fonts-dejavu-core \
    fonts-liberation \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid 1000 app \
    && useradd --uid 1000 --gid app --create-home --shell /usr/sbin/nologin app

COPY --from=builder --chown=app:app /opt/venv /opt/venv

ENV PATH="/opt/venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

# api.py and web_static/ are part of the resume_builder package itself
# (src/resume_builder/), so they're already installed into /opt/venv by
# the builder stage above — nothing extra to copy here.

USER app

# Render/Cloud Run inject $PORT; default to 8000 for local runs.
ENV PORT=8000
EXPOSE 8000
CMD ["sh", "-c", "uvicorn resume_builder.api:app --host 0.0.0.0 --port ${PORT}"]
