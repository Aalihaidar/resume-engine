# docker/Dockerfile.prod
# Production image: serves the FastAPI app (api.py) — JSON-in/PDF-out API
# plus the manual-fill web form. This is the image deployed to Render.
#
# Multi-stage build:
#   1. "builder" — has compilers/uv, resolves + installs dependencies and
#      the project itself into a standalone venv.
#   2. "runtime" — starts fresh from a slim base, copies only the finished
#      venv + source, adds WeasyPrint's *runtime* libs (no -dev/-headers
#      packages, no compilers, no git/ssh), and runs as a non-root user.
#
# Result: no build tools, no shell-access tooling, no root, small final
# image.

# Every image is pinned as tag@sha256 digest: the tag says which version, the
# digest guarantees the exact bytes (a tag can be re-pointed). Dependabot's
# docker ecosystem bumps both together.
# uv comes in as its own stage so Dependabot's docker ecosystem, which reads
# FROM lines (not images named inside COPY --from=), keeps it up to date.
FROM ghcr.io/astral-sh/uv:0.12.21@sha256:a7aed3216253ee804de3e2d8afa5073baa1a177335345d43845cd4165e43b711 AS uv

# ---------- Stage 1: builder ----------
FROM python:3.14-slim-bookworm@sha256:82bc3c539b8813ada9d68c63b40158fa002f7f33de9bf3312a3dfdc0620dff56 AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=uv /uv /uvx /usr/local/bin/

ENV UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_COMPILE_BYTECODE=1

WORKDIR /build

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY README.md LICENSE ./
COPY src ./src
RUN uv sync --frozen --no-dev --no-editable

# ---------- Stage 2: runtime ----------
FROM python:3.14-slim-bookworm@sha256:82bc3c539b8813ada9d68c63b40158fa002f7f33de9bf3312a3dfdc0620dff56 AS runtime

# `upgrade` ships Debian security fixes for packages already in the base
# image without waiting for the python image to be rebuilt.
RUN apt-get update && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libcairo2 \
    libgdk-pixbuf-2.0-0 \
    libharfbuzz-subset0 \
    libffi8 \
    shared-mime-info \
    fonts-dejavu-core \
    fonts-liberation \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Nothing is installed at runtime (the venv is built in the builder stage),
# so the base image's pip is dead weight — and its vendored libraries
# (urllib3, msgpack, setuptools' pkg_resources, …) are the only Python
# packages in the image that scanners flag. Remove it.
RUN python -m pip uninstall --yes --root-user-action=ignore pip

RUN groupadd --gid 1000 app \
    && useradd --uid 1000 --gid app --create-home --shell /usr/sbin/nologin app

COPY --from=builder --chown=app:app /opt/venv /opt/venv

ENV PATH="/opt/venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

# api.py and web_static/ are part of the resume_builder package itself
# (src/resume_builder/), so they're already installed into /opt/venv by
# the builder stage above — nothing extra to copy here.

USER app

# Render/Cloud Run inject $PORT; default to 8000 for local runs.
ENV PORT=8000
EXPOSE 8000
CMD ["sh", "-c", "uvicorn resume_builder.api:app --host 0.0.0.0 --port ${PORT}"]
