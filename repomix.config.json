{
  "output": {
    "filePath": "resume-engine.xml",
    "style": "xml",
    "compress": false,
    "removeComments": false,
    "removeEmptyLines": false,
    "showLineNumbers": false,
    "copyToClipboard": false,
    "parsableStyle": true,
    "topFilesLength": 10,
    "git": {
      "sortByChanges": true,
      "sortByChangesMaxCommits": 100
    },
    "headerText": "resume-engine — Python resume build system (WeasyPrint + Jinja2 + Pydantic).\nGenerated by Repomix for AI-assisted code review and analysis."
  },
  "include": [
    ".devcontainer/**",
    ".github/**",
    "docker/**",
    "data/**",
    "src/**",
    "schema/**",
    "scripts/**",
    "tests/**",
    "README.md",
    "pyproject.toml",
    "docker-compose.yml",
    "docker-compose.prod.yml",
    ".env.example",
    ".pre-commit-config.yaml",
    "Makefile"
  ],
  "ignore": {
    "useGitignore": true,
    "customPatterns": [
      "output/**",
      "uv.lock",
      "*.pdf",
      "*.png",
      "*.jpg",
      "*.jpeg",
      "**/devcontainer-lock.json"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  }
}